{
  "openapi": "3.0.3",
  "info": {
    "title": "StuHelper Information Query",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/information-query/query": {
      "post": {
        "operationId": "queryInformation",
        "description": "Authenticated principal and delivery channel are supplied by trusted host middleware. Query values must not be logged. Sensitive data is released only after audit commits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or audit unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/information-query/audit/query": {
      "post": {
        "operationId": "queryInformationAudit",
        "description": "Authenticated principal and delivery channel are supplied by trusted host middleware. Query values must not be logged. Sensitive data is released only after audit commits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or audit unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "school",
          "group",
          "module"
        ]
      },
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "name",
              "student_id",
              "qq",
              "account"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "profiles",
                "verification",
                "catalog",
                "reviews",
                "resources",
                "billing",
                "groups"
              ]
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "identity",
                "document",
                "material",
                "refund_payee"
              ]
            },
            "description": "Sensitive categories explicitly requested; omitted means masked identity fields only."
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Total returned domain records, across all candidate groups. Candidate groups are capped at 50; processing budget may produce a shorter page."
          },
          "after": {
            "type": "string",
            "maxLength": 4096,
            "description": "Opaque composite continuation for candidate and domain records; reuse only with the same query and principal. Stable exclusive pagination for unchanged source facts. Each request processes at most 50 candidates and 700 domain records; a short page can have a continuation."
          }
        },
        "required": [
          "kind",
          "value",
          "scope",
          "domains",
          "purpose",
          "limit"
        ]
      },
      "Field": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "business",
              "identity",
              "document",
              "material",
              "refund_payee"
            ]
          },
          "value": {
            "type": "string"
          },
          "masked": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "category",
          "value",
          "masked"
        ]
      },
      "Record": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "source": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            }
          }
        },
        "required": [
          "id",
          "subject",
          "scope",
          "source",
          "current",
          "changed_at",
          "fields"
        ]
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "next_cursor": {
            "type": "string"
          },
          "unavailable_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Authorized domains with no registered provider; consumers must show incomplete results."
          },
          "groups": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CandidateGroup"
            }
          }
        },
        "required": [
          "groups",
          "next_cursor",
          "unavailable_domains"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "AuditFilter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "after": {
            "type": "string",
            "pattern": "^[0-9]*$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "scope",
          "purpose",
          "after",
          "limit"
        ]
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "channel": {
            "type": "string"
          },
          "target_group": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "actor",
          "request_id",
          "purpose",
          "scope",
          "channel",
          "target_group",
          "action",
          "result",
          "count",
          "targets",
          "fields",
          "basis",
          "created_at"
        ]
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "label": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "description": "Masked distinguishing fields only."
          }
        },
        "required": [
          "account",
          "source",
          "current",
          "changed_at",
          "scope",
          "label"
        ]
      },
      "CandidateGroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/Candidate"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          }
        },
        "required": [
          "candidate",
          "items"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
