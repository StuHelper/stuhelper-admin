{
  "name": "stuhelper-admin",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/StuHelper/stuhelper-admin",
  "repository": "StuHelper/stuhelper-admin",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "stub": "pnpm -r --if-present run stub",
    "build": "pnpm --filter @stuhelper/admin build",
    "dev": "pnpm --filter @stuhelper/admin dev",
    "preview": "pnpm --filter @stuhelper/admin preview",
    "typecheck": "pnpm --filter @stuhelper/admin typecheck",
    "lint": "pnpm exec eslint apps/web-antd/src packages/locales/src/langs --max-warnings=0",
    "test": "vitest run",
    "generate": "pnpm --dir scripts/contracts generate",
    "check": "pnpm run check:i18n && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "postinstall": "pnpm -r --if-present run stub",
    "check:i18n": "stuhelper-check i18n"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "@stuhelper/engineering-tools": "git+https://github.com/StuHelper/stuhelper-next.git#tooling-v0.1.2"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.33.4"
  },
  "packageManager": "pnpm@10.33.4"
}
